                title: "Skladování a VMI",
                icon: "🏭",
                desc: "Vendor Managed Inventory (VMI) je vlajkovou lodí JUSDA. Sklady nejsou jen 'krabice', ale inteligentní huby řídící zásoby pro výrobní linky.",
                features: ["VMI (Řízení zásob dodavatelem)", "Bonded warehouses (Celní sklady)", "Just-in-Time (JIT) dodávky do výroby", "Pick & Pack služby"]
            },
            'tech': {
                title: "Technologie a SCM Platforma",
                icon: "🖥️",
                desc: "JUSDA není jen přepravce, ale technologická firma. Vlastní cloudová platforma 'JUSDA SCM' integruje data od všech dopravců na jedno místo.",
                features: ["Control Tower (Centrální dispečink)", "Real-time visibility", "Prediktivní analýza zpoždění", "Elektronická výměna dat (EDI)"]
            }
        };

        // --- NAVIGATION LOGIC ---

        function navTo(sectionId) {
            // Update UI Tabs
            document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));
            const navBtn = document.getElementById(`nav-${sectionId}`);
            if(navBtn) navBtn.classList.add('active');

            // Show Section
            ['overview', 'services', 'market', 'future'].forEach(id => {
                const el = document.getElementById(id);
                if (id === sectionId) {
                    el.classList.remove('hidden');
                    // Trigger chart resize if chart exists in this section
                    if (id === 'market' && marketChart) marketChart.resize();
                    if (id === 'future' && trendChart) trendChart.resize();
                } else {
                    el.classList.add('hidden');
                }
            });

            // Close mobile menu if open
            document.getElementById('mobile-menu').classList.add('hidden');
            
            // Scroll to top
            window.scrollTo(0,0);
        }

        function toggleMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            menu.classList.toggle('hidden');
        }

        // --- SERVICE DETAIL LOGIC ---

        function showService(key) {
            const data = serviceData[key];
            
            // Highlight Button
            document.querySelectorAll('.service-card').forEach(el => el.classList.remove('active', 'border-sky-500', 'bg-sky-50'));
            const activeBtn = document.getElementById(`btn-${key}`);
            activeBtn.classList.add('active', 'border-sky-500', 'bg-sky-50');

            // Update Content
            const container = document.getElementById('service-content');
            container.innerHTML = `
                <div class="animate-fade-in">
                    <div class="flex items-center gap-4 mb-4">
                        <span class="text-4xl">${data.icon}</span>
                        <h3 class="text-2xl font-bold text-slate-800">${data.title}</h3>
                    </div>
                    <p class="text-lg text-slate-600 mb-6 leading-relaxed">${data.desc}</p>
                    <div class="bg-white rounded-lg p-5 border border-slate-200 shadow-inner">
                        <h4 class="font-bold text-slate-700 mb-3 text-sm uppercase tracking-wide">Klíčové schopnosti:</h4>
                        <ul class="grid grid-cols-1 md:grid-cols-2 gap-3">
                            ${data.features.map(f => `<li class="flex items-center gap-2 text-slate-600"><span class="text-sky-500">✓</span> ${f}</li>`).join('')}
                        </ul>
                    </div>
                </div>
            `;
        }

        // --- CHART INITIALIZATION ---

        let marketChart, trendChart;

        window.onload = function() {
            // Initialize default service view
            showService('air');

            // Market Chart
            const ctxMarket = document.getElementById('marketChart').getContext('2d');
            marketChart = new Chart(ctxMarket, {
                type: 'bar',
                data: {
                    labels: ['DHL Supply Chain', 'Kuehne + Nagel', 'DB Schenker', 'DSV', 'JUSDA (Niche Focus)'],
                    datasets: [
                        {
                            label: 'Celkový Globální Obrat (Mld. USD - Odhad)',
                            data: [35, 30, 25, 20, 5], // Illustrative relative scale
                            backgroundColor: '#cbd5e1',
                            borderRadius: 4
                        },
                        {
                            label: 'Specializace na Electronics/Mfg (Skóre 1-10)',
                            data: [7, 6, 6, 5, 10], // Highlighting JUSDA's specialization
                            backgroundColor: '#0ea5e9',
                            borderRadius: 4,
                            yAxisID: 'y1'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        tooltip: {
                            mode: 'index',
                            intersect: false,
                            callbacks: {
                                footer: (items) => {
                                    if(items[0].label.includes('JUSDA')) return "JUSDA má menší celkový objem, ale dominuje v integraci s výrobou.";
                                    return "";
                                }
                            }
                        },
                        legend: { position: 'bottom' }
                    },
                    scales: {
                        y: { 
                            beginAtZero: true, 
                            title: { display: true, text: 'Globální objem (Měřítko)' },
                            grid: { display: false }
                        },
                        y1: {
                            type: 'linear',
                            display: true,
                            position: 'right',
                            title: { display: true, text: 'Specializace (Skóre)' },
                            min: 0, max: 12,
                            grid: { drawOnChartArea: false }
                        }
                    }
                }
            });

            // Trend Chart
            const ctxTrend = document.getElementById('trendChart').getContext('2d');
            trendChart = new Chart(ctxTrend, {
                type: 'line',
                data: {
                    labels: ['2020', '2021', '2022', '2023', '2024', '2025 (Predikce)', '2026 (Predikce)'],
                    datasets: [
                        {
                            label: 'Manuální Procesy & Tradiční Logistika',
                            data: [80, 75, 70, 60, 50, 40, 30],
                            borderColor: '#94a3b8',
                            tension: 0.4,
                            fill: false
                        },
                        {
                            label: 'AI, Automatizace & Smart SCM',
                            data: [20, 25, 30, 40, 50, 60, 70],
                            borderColor: '#0ea5e9',
                            backgroundColor: 'rgba(14, 165, 233, 0.1)',
                            borderWidth: 3,
                            tension: 0.4,
                            fill: true
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return context.dataset.label + ': ' + context.parsed.y + '% Podíl na efektivitě';
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 100,
                            title: { display: true, text: 'Míra adopce technologií (%)' }
                        }
                    }
                }
            });
        };

    </script>
</body>
</html>
