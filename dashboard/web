<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JUSDA: Analýza Trhu a Strategický Profil</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        /* --- Chosen Palette: Industrial Tech --- */
        body {
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
        }

        .glass-panel {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border: 1px solid #e2e8f0;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        }

        .nav-item.active {
            border-bottom: 2px solid #0ea5e9;
            color: #0f172a;
            font-weight: 600;
        }

        .chart-container {
            position: relative;
            width: 100%;
            max-width: 800px;
            margin-left: auto;
            margin-right: auto;
            height: 350px;
            max-height: 400px;
        }

        @media (max-width: 640px) {
            .chart-container {
                height: 250px;
            }
        }

        .service-card {
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .service-card:hover {
            transform: translateY(-2px);
            border-color: #0ea5e9;
            box-shadow: 0 10px 15px -3px rgba(14, 165, 233, 0.1);
        }

        .service-card.active {
            background-color: #f0f9ff;
            border-color: #0ea5e9;
        }

        .animate-fade-in {
            animation: fadeIn 0.5s ease-in-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .gemini-gradient {
            background: linear-gradient(135deg, #4285f4 0%, #9b72cb 100%);
        }
    </style>
    <!-- CONFIRMATION: NO SVG graphics used. NO Mermaid JS used. -->
</head>
<body class="min-h-screen flex flex-col">

    <!-- Navigation -->
    <nav class="bg-white border-b border-slate-200 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <div class="flex-shrink-0 flex items-center gap-2">
                        <span class="text-2xl font-bold text-slate-900 tracking-tighter">JUSDA<span class="text-sky-500">.</span></span>
                        <span class="text-xs text-slate-500 uppercase tracking-widest border-l border-slate-300 pl-2 ml-2 hidden sm:inline">Supply Chain Intelligence</span>
                    </div>
                </div>
                <div class="hidden sm:flex sm:space-x-8">
                    <button onclick="navTo('overview')" id="nav-overview" class="nav-item active inline-flex items-center px-1 pt-1 text-sm font-medium text-slate-500 hover:text-slate-700">Přehled & Identita</button>
                    <button onclick="navTo('services')" id="nav-services" class="nav-item inline-flex items-center px-1 pt-1 text-sm font-medium text-slate-500 hover:text-slate-700">Služby & Produkty</button>
                    <button onclick="navTo('market')" id="nav-market" class="nav-item inline-flex items-center px-1 pt-1 text-sm font-medium text-slate-500 hover:text-slate-700">Trh & Konkurence</button>
                    <button onclick="navTo('future')" id="nav-future" class="nav-item inline-flex items-center px-1 pt-1 text-sm font-medium text-slate-500 hover:text-slate-700">Trendy & AI (2026+)</button>
                    <button onclick="navTo('gemini')" id="nav-gemini" class="inline-flex items-center px-3 py-1 my-3 text-sm font-medium text-white gemini-gradient rounded-full">Logistický Mozek ✨</button>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content Area -->
    <main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">

        <!-- SECTION 1: OVERVIEW & IDENTITY -->
        <section id="overview" class="animate-fade-in space-y-8">
            <div class="bg-gradient-to-r from-slate-900 to-slate-800 rounded-2xl p-8 text-white shadow-xl relative overflow-hidden">
                <div class="relative z-10">
                    <h1 class="text-3xl md:text-5xl font-bold mb-4">Asian Roots, European Heart</h1>
                    <p class="text-slate-300 text-lg md:text-xl max-w-3xl">
                        Komplexní analýza společnosti JUSDA Europe. Od dceřiné společnosti Foxconnu po klíčového hráče v dodavatelském řetězci propojujícího Východ a Západ.
                    </p>
                    <div class="mt-8 flex flex-wrap gap-4">
                        <div class="bg-white/10 backdrop-blur rounded-lg p-4 border border-white/20">
                            <div class="text-sm text-slate-400">Mateřská společnost</div>
                            <div class="font-bold text-lg">Foxconn Technology Group</div>
                        </div>
                        <div class="bg-white/10 backdrop-blur rounded-lg p-4 border border-white/20">
                            <div class="text-sm text-slate-400">Sídlo Evropa</div>
                            <div class="font-bold text-lg">Pardubice, Česká republika</div>
                        </div>
                        <div class="bg-white/10 backdrop-blur rounded-lg p-4 border border-white/20">
                            <div class="text-sm text-slate-400">Zaměření</div>
                            <div class="font-bold text-lg">Smart Manufacturing Logistics</div>
                        </div>
                    </div>
                </div>
                <div class="absolute -right-20 -bottom-40 w-80 h-80 bg-sky-500 rounded-full blur-3xl opacity-20"></div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div class="glass-panel p-6 rounded-xl">
                    <h2 class="text-xl font-bold text-slate-800 mb-4 border-l-4 border-sky-500 pl-3">Identita & Kontext</h2>
                    <p class="text-slate-600 mb-4 leading-relaxed">
                        <strong>JUSDA</strong> vznikla jako logistická divize technologického giganta <strong>Foxconn</strong>. 
                        Její unikátní pozice vychází z hluboké znalosti výrobních procesů ("Manufacturing Logistics").
                    </p>
                    <p class="text-slate-600 leading-relaxed">
                        Společnost funguje jako most mezi Asií a Evropou. Evropské srdce bije v <strong>České republice</strong>, odkud řídí region EMEA.
                    </p>
                </div>

                <div class="glass-panel p-6 rounded-xl">
                    <h2 class="text-xl font-bold text-slate-800 mb-4 border-l-4 border-amber-500 pl-3">Firemní Hierarchie</h2>
                    <div class="space-y-4 font-mono text-sm">
                        <div class="flex items-center">
                            <span class="text-2xl mr-2">🏭</span>
                            <div class="bg-slate-100 p-3 rounded w-full border border-slate-300">
                                <span class="font-bold text-slate-900">FOXCONN Technology Group</span>
                            </div>
                        </div>
                        <div class="flex items-center pl-8">
                            <span class="text-2xl mr-2 text-slate-400">↳</span>
                            <div class="bg-sky-50 p-3 rounded w-full border border-sky-200">
                                <span class="font-bold text-sky-900">JUSDA International</span>
                            </div>
                        </div>
                        <div class="flex items-center pl-16">
                            <span class="text-2xl mr-2 text-sky-400">↳</span>
                            <div class="bg-blue-600 p-3 rounded w-full text-white shadow-lg">
                                <span class="font-bold">JUSDA Europe</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECTION 2: SERVICES & INFRASTRUCTURE -->
        <section id="services" class="hidden animate-fade-in space-y-8">
            <div class="text-center max-w-3xl mx-auto mb-8">
                <h2 class="text-3xl font-bold text-slate-900">Infrastruktura & Služby</h2>
                <p class="text-slate-600 mt-2">Optimalizace dodavatelského řetězce s využitím VMI a JIT konceptů.</p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <div class="lg:col-span-1 space-y-3">
                    <div onclick="showService('air')" id="btn-air" class="service-card active bg-white p-4 rounded-lg border border-slate-200 flex items-center justify-between">
                        <div class="flex items-center gap-3"><span class="text-2xl">✈️</span> <div class="font-bold text-slate-700">Letecká Přeprava</div></div>
                    </div>
                    <div onclick="showService('sea')" id="btn-sea" class="service-card bg-white p-4 rounded-lg border border-slate-200 flex items-center justify-between">
                        <div class="flex items-center gap-3"><span class="text-2xl">🚢</span> <div class="font-bold text-slate-700">Námořní Přeprava</div></div>
                    </div>
                    <div onclick="showService('road')" id="btn-road" class="service-card bg-white p-4 rounded-lg border border-slate-200 flex items-center justify-between">
                        <div class="flex items-center gap-3"><span class="text-2xl">🚚</span> <div class="font-bold text-slate-700">Silniční & Železniční</div></div>
                    </div>
                    <div onclick="showService('warehouse')" id="btn-warehouse" class="service-card bg-white p-4 rounded-lg border border-slate-200 flex items-center justify-between">
                        <div class="flex items-center gap-3"><span class="text-2xl">🏭</span> <div class="font-bold text-slate-700">Sklady & VMI</div></div>
                    </div>
                </div>

                <div class="lg:col-span-2 glass-panel p-8 rounded-xl min-h-[400px] flex flex-col justify-center relative">
                    <div id="service-content"></div>
                </div>
            </div>
        </section>

        <!-- SECTION 3: MARKET & COMPETITION -->
        <section id="market" class="hidden animate-fade-in space-y-8">
            <div class="bg-white p-6 rounded-xl border-l-4 border-indigo-500 shadow-sm">
                <h2 class="text-xl font-bold text-slate-900">Srovnání na trhu</h2>
                <p class="text-slate-600 mt-2">Dominance v segmentu <strong>High-Tech & Electronics Supply Chain</strong>.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div class="glass-panel p-6 rounded-xl">
                    <h3 class="text-lg font-semibold text-slate-700 mb-4">Pozice na trhu</h3>
                    <div class="chart-container"><canvas id="marketChart"></canvas></div>
                </div>

                <div class="glass-panel p-6 rounded-xl">
                    <h3 class="text-lg font-semibold text-slate-700 mb-4">Srovnání Služeb</h3>
                    <div class="overflow-x-auto">
                        <table class="min-w-full text-sm text-left">
                            <thead class="bg-slate-100 text-slate-600 uppercase font-bold text-xs">
                                <tr><th>Firma</th><th>High-Tech Focus</th><th>Asia-EU Bridge</th></tr>
                            </thead>
                            <tbody class="divide-y divide-slate-200">
                                <tr class="bg-blue-50">
                                    <td class="px-4 py-3 font-bold text-blue-900">JUSDA</td>
                                    <td class="px-4 py-3 text-green-600">●●●</td>
                                    <td class="px-4 py-3 text-green-600">●●●</td>
                                </tr>
                                <tr>
                                    <td class="px-4 py-3 font-medium">DHL Supply Chain</td>
                                    <td class="px-4 py-3 text-yellow-600">●●○</td>
                                    <td class="px-4 py-3 text-green-600">●●●</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECTION 4: TRENDS & FUTURE -->
        <section id="future" class="hidden animate-fade-in space-y-8">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <div class="lg:col-span-1 space-y-6">
                    <div class="glass-panel p-6 rounded-xl border-t-4 border-sky-500">
                        <h3 class="text-lg font-bold text-slate-800 mb-2">Výzkum Trendů (2020-2026+)</h3>
                        <p class="text-sm text-slate-600">Logistika prochází fází "Inteligentní Transformace".</p>
                    </div>
                    
                    <div class="glass-panel p-6 rounded-xl border-t-4 border-amber-500">
                        <h3 class="text-lg font-bold text-slate-800 mb-4">Vliv AI na Pozice</h3>
                        <div id="ai-job-result" class="text-sm text-slate-600 space-y-2 mb-4">
                            Klikněte pro generování hluboké analýzy dopadu AI na role v JUSDA.
                        </div>
                        <button onclick="generateJobAnalysis()" id="job-analysis-btn" class="w-full py-2 px-4 gemini-gradient text-white rounded-lg font-medium hover:opacity-90 transition-opacity">
                            Analyzovat role AI ✨
                        </button>
                    </div>
                </div>

                <div class="lg:col-span-2 glass-panel p-6 rounded-xl flex flex-col">
                    <h3 class="text-lg font-bold text-slate-800 mb-4">Predikce Růstu</h3>
                    <div class="chart-container flex-grow"><canvas id="trendChart"></canvas></div>
                </div>
            </div>
        </section>

        <!-- SECTION 5: GEMINI ASSISTANT -->
        <section id="gemini" class="hidden animate-fade-in space-y-8">
            <div class="max-w-4xl mx-auto">
                <div class="gemini-gradient p-8 rounded-2xl text-white shadow-2xl mb-8">
                    <h2 class="text-3xl font-bold mb-2">Logistický Mozek ✨</h2>
                    <p class="opacity-90">Zeptejte se umělé inteligence na strategický dopad globálních událostí na JUSDA Europe nebo si nechte vypracovat predikci trhu.</p>
                </div>

                <div class="glass-panel p-6 rounded-xl space-y-4">
                    <div class="flex flex-col gap-2">
                        <label class="text-sm font-bold text-slate-700">O čem chcete diskutovat?</label>
                        <div class="flex gap-2">
                            <input type="text" id="gemini-query" placeholder="Např. 'Dopad uzavření Suezského průplavu na JUSDA'..." class="flex-grow p-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-sky-500 outline-none">
                            <button onclick="askGemini()" id="gemini-btn" class="bg-slate-900 text-white px-6 py-3 rounded-lg font-bold hover:bg-slate-800 transition-colors">
                                Analyzovat ✨
                            </button>
                        </div>
                    </div>

                    <div id="gemini-loading" class="hidden flex items-center justify-center py-10">
                        <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-sky-500"></div>
                        <span class="ml-3 text-slate-600">Gemini přemýšlí...</span>
                    </div>

                    <div id="gemini-response" class="hidden bg-slate-50 p-6 rounded-lg border border-slate-200 text-slate-700 leading-relaxed whitespace-pre-wrap">
                        <!-- Response will appear here -->
                    </div>

                    <div id="gemini-sources" class="hidden mt-4 pt-4 border-t border-slate-200">
                        <h4 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-2">Informační zdroje</h4>
                        <div id="sources-list" class="flex flex-wrap gap-2"></div>
                    </div>
                </div>
            </div>
        </section>

    </main>

    <!-- Footer -->
    <footer class="bg-slate-900 text-slate-400 py-8 mt-auto">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-3 gap-8 text-sm">
            <div>
                <h4 class="text-white font-bold mb-2">JUSDA Europe</h4>
                <p>Pardubice, Česká republika</p>
            </div>
            <div>
                <h4 class="text-white font-bold mb-2">AI Integrace</h4>
                <p>Poháněno modelem Gemini 2.5 Flash Preview</p>
            </div>
        </div>
    </footer>

    <script>
        // --- CONSTANTS & CONFIG ---
        const apiKey = "";
        const modelName = "gemini-2.5-flash-preview-09-2025";
        
        const serviceData = {
            'air': {
                title: "Letecká Přeprava (Air Freight)",
                icon: "✈️",
                desc: "JUSDA se specializuje na rychlou přepravu elektronických komponentů.",
                features: ["Charterové lety", "Door-to-Door", "Celní odbavení"]
            },
            'sea': {
                title: "Námořní Přeprava (Sea Freight)",
                icon: "🚢",
                desc: "Ekonomická páteř logistiky mezi Asií a Evropou.",
                features: ["FCL/LCL", "Kombinovaná Sea-Air", "Real-time tracking"]
            },
            'road': {
                title: "Silniční a Železniční Doprava",
                icon: "🚚",
                desc: "Klíčová pro evropskou distribuci a 'Silk Road'.",
                features: ["FTL/LTL po EU", "Hedvábná stezka", "Cross-docking"]
            },
            'warehouse': {
                title: "Skladování a VMI",
                icon: "🏭",
                desc: "Vendor Managed Inventory (VMI) je vlajkovou lodí JUSDA.",
                features: ["VMI řízení", "Celní sklady", "Just-in-Time"]
            }
        };

        // --- GEMINI API INTEGRATION ---
        
        async function callGemini(prompt, useSearch = true) {
            let backoff = 1000;
            const maxRetries = 5;
            
            const payload = {
                contents: [{ parts: [{ text: prompt }] }],
                systemInstruction: { 
                    parts: [{ text: "Jsi expert na logistiku a dodavatelské řetězce se zaměřením na společnost JUSDA Europe. Odpovídej v češtině, profesionálně, věcně a s důrazem na strategický kontext Foxconnu a evropského trhu." }]
                }
            };

            if (useSearch) {
                payload.tools = [{ "google_search": {} }];
            }

            for (let i = 0; i < maxRetries; i++) {
                try {
                    const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/${modelName}:generateContent?key=${apiKey}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });

                    if (!response.ok) throw new Error('API request failed');

                    const result = await response.json();
                    return result;
                } catch (error) {
                    if (i === maxRetries - 1) throw error;
                    await new Promise(resolve => setTimeout(resolve, backoff));
                    backoff *= 2;
                }
            }
        }

        async function askGemini() {
            const query = document.getElementById('gemini-query').value;
            if (!query) return;

            const btn = document.getElementById('gemini-btn');
            const loading = document.getElementById('gemini-loading');
            const responseDiv = document.getElementById('gemini-response');
            const sourcesDiv = document.getElementById('gemini-sources');
            const sourcesList = document.getElementById('sources-list');

            btn.disabled = true;
            loading.classList.remove('hidden');
            responseDiv.classList.add('hidden');
            sourcesDiv.classList.add('hidden');

            try {
                const result = await callGemini(`Analyzuj následující logistický dotaz v kontextu firmy JUSDA Europe: ${query}`);
                const text = result.candidates?.[0]?.content?.parts?.[0]?.text;
                const sources = result.candidates?.[0]?.groundingMetadata?.groundingAttributions;

                responseDiv.innerText = text;
                responseDiv.classList.remove('hidden');

                if (sources && sources.length > 0) {
                    sourcesList.innerHTML = sources.map(s => `
                        <a href="${s.web?.uri}" target="_blank" class="bg-white border border-slate-200 px-2 py-1 rounded text-[10px] text-sky-600 hover:bg-sky-50 transition-colors">
                            ${s.web?.title || 'Zdroj'}
                        </a>
                    `).join('');
                    sourcesDiv.classList.remove('hidden');
                }
            } catch (err) {
                responseDiv.innerText = "Omlouváme se, při analýze došlo k chybě. Zkuste to prosím později.";
                responseDiv.classList.remove('hidden');
            } finally {
                loading.classList.add('hidden');
                btn.disabled = false;
            }
        }

        async function generateJobAnalysis() {
            const resultDiv = document.getElementById('ai-job-result');
            const btn = document.getElementById('job-analysis-btn');
            
            btn.disabled = true;
            btn.innerText = "Analyzuji pozice... ✨";
            
            try {
                const result = await callGemini("Vypracuj detailní analýzu toho, jak AI ovlivní specifické pracovní pozice v logistické firmě jako JUSDA Europe (skladníci, dispečeři, nákupčí, IT). Rozděl to na ohrožené úkoly a nové příležitosti.", false);
                resultDiv.innerText = result.candidates?.[0]?.content?.parts?.[0]?.text;
            } catch (err) {
                resultDiv.innerText = "Nepodařilo se vygenerovat analýzu.";
            } finally {
                btn.disabled = false;
                btn.innerText = "Analyzovat role AI ✨";
            }
        }

        // --- NAVIGATION & UI LOGIC ---

        function navTo(sectionId) {
            document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));
            const navBtn = document.getElementById(`nav-${sectionId}`);
            if(navBtn) navBtn.classList.add('active');

            ['overview', 'services', 'market', 'future', 'gemini'].forEach(id => {
                const el = document.getElementById(id);
                if (id === sectionId) {
                    el.classList.remove('hidden');
                    if (id === 'market' && marketChart) marketChart.resize();
                    if (id === 'future' && trendChart) trendChart.resize();
                } else {
                    el.classList.add('hidden');
                }
            });
            window.scrollTo(0,0);
        }

        function showService(key) {
            const data = serviceData[key];
            document.querySelectorAll('.service-card').forEach(el => el.classList.remove('active', 'border-sky-500', 'bg-sky-50'));
            const activeBtn = document.getElementById(`btn-${key}`);
            activeBtn.classList.add('active', 'border-sky-500', 'bg-sky-50');

            const container = document.getElementById('service-content');
            container.innerHTML = `
                <div class="animate-fade-in">
                    <div class="flex items-center gap-4 mb-4">
                        <span class="text-4xl">${data.icon}</span>
                        <h3 class="text-2xl font-bold text-slate-800">${data.title}</h3>
                    </div>
                    <p class="text-lg text-slate-600 mb-6">${data.desc}</p>
                    <div class="bg-white rounded-lg p-5 border border-slate-200">
                        <ul class="grid grid-cols-1 md:grid-cols-2 gap-3">
                            ${data.features.map(f => `<li class="flex items-center gap-2 text-slate-600"><span class="text-sky-500">✓</span> ${f}</li>`).join('')}
                        </ul>
                    </div>
                </div>
            `;
        }

        // --- CHARTS ---

        let marketChart, trendChart;
        window.onload = function() {
            showService('air');
            const ctxMarket = document.getElementById('marketChart').getContext('2d');
            marketChart = new Chart(ctxMarket, {
                type: 'bar',
                data: {
                    labels: ['DHL', 'Kuehne+Nagel', 'Schenker', 'JUSDA'],
                    datasets: [{ label: 'Specializace na Electronics', data: [7, 6, 6, 10], backgroundColor: '#0ea5e9' }]
                },
                options: { responsive: true, maintainAspectRatio: false }
            });

            const ctxTrend = document.getElementById('trendChart').getContext('2d');
            trendChart = new Chart(ctxTrend, {
                type: 'line',
                data: {
                    labels: ['2020', '2022', '2024', '2026'],
                    datasets: [{ label: 'Adopce AI (%)', data: [20, 35, 55, 80], borderColor: '#0ea5e9', fill: true }]
                },
                options: { responsive: true, maintainAspectRatio: false }
            });
        };
    </script>
</body>
</html>
